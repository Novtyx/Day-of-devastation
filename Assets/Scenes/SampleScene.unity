      m_Calls: []
  m_text: "Day of devastation - \u0438\u0433\u0440\u0430 \u043E \u043C\u043E\u0449\u043D\u0435\u0439\u0448\u0435\u0439
    \u0441\u0438\u043B\u0435, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043C\u043E\u0436\u0435\u0442
    \u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043D\u0435 \u0432 \u0442\u0435\u0445
    \u0440\u0443\u043A\u0430\u0445. \u041F\u0440\u043E\u0432\u0435\u0434\u0438 \u0432\u044B\u0436\u0438\u0432\u0448\u0435\u0433\u043E
    \u0447\u0435\u0440\u0435\u0437 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u043D\u044B\u0439
    \u043C\u0438\u0440. \u041B\u0443\u0442\u0430\u0439 \u0433\u043E\u0440\u043E\u0434\u0430,
    \u0441\u043E\u0437\u0434\u0430\u0439 \u0441\u0432\u043E\u044E \u0431\u0430\u0437\u0443"
  m_isRightToLeft: 0
