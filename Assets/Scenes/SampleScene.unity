  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
    \u0432 \u0438\u0433\u0440\u0443. \u0412 \u0438\u0433\u0440\u0435 \u0435\u0449\u0435
    \u043A\u0443\u0447\u0430 \u0431\u0430\u0433\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F.
    \u0416\u0435\u043B\u0430\u044E \u0445\u043E\u0440\u043E\u0448\u043E \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
    \u0432\u0440\u0435\u043C\u044F. \u041F\u0440\u043E\u0448\u0443 \u043F\u043E\u043C\u043D\u0438\u0442\u044C,
    \u0447\u0442\u043E \u0442\u0435\u0443\u0449\u0430\u044F \u0446\u0435\u043B\u044C
    - \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0438,
    \u0430 \u0443\u0436\u0435 \u043F\u043E\u0442\u043E\u043C \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u0442\u044C
    \u0438\u0433\u0440\u0443 \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u043E\u043C.\n\u0425\u043E\u0442\u0438\u0442\u0435
    \u043F\u0440\u043E\u0439\u0442\u0438 \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435?"
  m_isRightToLeft: 0
